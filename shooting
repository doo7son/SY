<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>미니 크래프트</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #1d2833;
            color: #f4f4f4;
            display: flex;
            flex-direction: column;
            align-items: center;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        h1 {
            margin: 20px 0 8px;
        }

        canvas {
            background-color: #87ceeb;
            border: 3px solid #444;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
        }

        .panel {
            width: 660px;
            max-width: calc(100% - 40px);
            margin-top: 12px;
            background-color: rgba(20, 30, 42, 0.95);
            padding: 12px 14px;
            border-radius: 10px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.35);
        }

        p, .status {
            margin: 8px 0;
            line-height: 1.5;
        }

        .status {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
        }

        .block-key {
            display: inline-block;
            min-width: 80px;
        }
    </style>
</head>
<body>
    <h1>미니 크래프트</h1>
    <canvas id="gameCanvas" width="640" height="480"></canvas>
    <div class="panel">
        <p><strong>조작:</strong> A / D 이동, W 또는 Space 점프, 숫자 1-4 블록 선택, 왼쪽 클릭으로 설치, 오른쪽 클릭으로 파괴</p>
        <div class="status">
            <span id="selectedBlock">선택된 블록: 흙</span>
            <span id="instruction">마우스로 블록을 클릭하여 설치하거나 파괴하세요.</span>
        </div>
    </div>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");
        const selectedBlockText = document.getElementById("selectedBlock");

        const TILE_SIZE = 32;
        const COLS = Math.floor(canvas.width / TILE_SIZE);
        const ROWS = Math.floor(canvas.height / TILE_SIZE);

        const BLOCKS = [
            { id: 0, name: "공기", color: "#87ceeb", solid: false },
            { id: 1, name: "흙", color: "#8b5a2b", solid: true },
            { id: 2, name: "잔디", color: "#4f8f25", solid: true },
            { id: 3, name: "돌", color: "#7f7f7f", solid: true },
            { id: 4, name: "나무", color: "#8b4513", solid: true }
        ];

        let selectedBlock = 1;

        const world = [];
        for (let y = 0; y < ROWS; y++) {
            world[y] = [];
            for (let x = 0; x < COLS; x++) {
                world[y][x] = 0;
            }
        }

        function generateTerrain() {
            const groundHeight = Math.floor(ROWS * 0.6);
            let height = groundHeight;
            for (let x = 0; x < COLS; x++) {
                if (Math.random() < 0.4) height += Math.floor(Math.random() * 3) - 1;
                height = Math.max(ROWS * 0.4, Math.min(ROWS - 4, height));
                for (let y = 0; y < ROWS; y++) {
                    if (y < height) world[y][x] = 0;
                    else if (y === height) world[y][x] = 2;
                    else if (y < height + 3) world[y][x] = 1;
                    else if (y < height + 6) world[y][x] = 3;
                    else world[y][x] = 1;
                }
            }
        }

        generateTerrain();

        const player = {
            x: Math.floor(COLS / 2) * TILE_SIZE,
            y: 0,
            width: TILE_SIZE * 0.8,
            height: TILE_SIZE * 1.6,
            dx: 0,
            dy: 0,
            speed: 3,
            jumpPower: -10,
            grounded: false
        };

        const keys = { left: false, right: false, up: false };

        document.addEventListener("keydown", (e) => {
            if (e.key === "a" || e.key === "A") keys.left = true;
            if (e.key === "d" || e.key === "D") keys.right = true;
            if (e.key === "w" || e.key === "W" || e.code === "Space") keys.up = true;
            if (e.key >= "1" && e.key <= "4") {
                selectedBlock = Number(e.key);
                selectedBlockText.textContent = `선택된 블록: ${BLOCKS[selectedBlock].name}`;
            }
        });

        document.addEventListener("keyup", (e) => {
            if (e.key === "a" || e.key === "A") keys.left = false;
            if (e.key === "d" || e.key === "D") keys.right = false;
            if (e.key === "w" || e.key === "W" || e.code === "Space") keys.up = false;
        });

        function isSolidBlock(x, y) {
            if (x < 0 || x >= COLS || y < 0 || y >= ROWS) return x < 0 || x >= COLS || y >= ROWS;
            return BLOCKS[world[y][x]].solid;
        }

        function collidePlayer() {
            const left = player.x;
            const right = player.x + player.width;
            const top = player.y;
            const bottom = player.y + player.height;

            const leftTile = Math.floor(left / TILE_SIZE);
            const rightTile = Math.floor((right - 1) / TILE_SIZE);
            const topTile = Math.floor(top / TILE_SIZE);
            const bottomTile = Math.floor((bottom - 1) / TILE_SIZE);

            if (player.dy > 0) {
                for (let x = leftTile; x <= rightTile; x++) {
                    if (isSolidBlock(x, bottomTile)) {
                        player.y = bottomTile * TILE_SIZE - player.height;
                        player.dy = 0;
                        player.grounded = true;
                        break;
                    } else {
                        player.grounded = false;
                    }
                }
            }

            if (player.dy < 0) {
                for (let x = leftTile; x <= rightTile; x++) {
                    if (isSolidBlock(x, topTile)) {
                        player.y = (topTile + 1) * TILE_SIZE;
                        player.dy = 0;
                        break;
                    }
                }
            }

            if (player.dx > 0) {
                for (let y = topTile; y <= bottomTile; y++) {
                    if (isSolidBlock(rightTile, y)) {
                        player.x = rightTile * TILE_SIZE - player.width;
                        player.dx = 0;
                        break;
                    }
                }
            }

            if (player.dx < 0) {
                for (let y = topTile; y <= bottomTile; y++) {
                    if (isSolidBlock(leftTile, y)) {
                        player.x = (leftTile + 1) * TILE_SIZE;
                        player.dx = 0;
                        break;
                    }
                }
            }
        }

        function update() {
            player.dx = 0;
            if (keys.left) player.dx = -player.speed;
            if (keys.right) player.dx = player.speed;

            if (keys.up && player.grounded) {
                player.dy = player.jumpPower;
                player.grounded = false;
            }

            player.dy += 0.5;
            player.dy = Math.min(player.dy, 12);

            player.x += player.dx;
            collidePlayer();
            player.y += player.dy;
            collidePlayer();

            if (player.x < 0) player.x = 0;
            if (player.x + player.width > canvas.width) player.x = canvas.width - player.width;
            if (player.y + player.height > canvas.height) {
                player.y = canvas.height - player.height;
                player.dy = 0;
                player.grounded = true;
            }
        }

        function drawGrid() {
            for (let y = 0; y < ROWS; y++) {
                for (let x = 0; x < COLS; x++) {
                    const block = BLOCKS[world[y][x]];
                    ctx.fillStyle = block.color;
                    ctx.fillRect(x * TILE_SIZE, y * TILE_SIZE, TILE_SIZE, TILE_SIZE);
                }
            }
        }

        function drawPlayer() {
            ctx.fillStyle = "#ffeb3b";
            ctx.fillRect(player.x, player.y, player.width, player.height);
            ctx.strokeStyle = "#000";
            ctx.lineWidth = 2;
            ctx.strokeRect(player.x, player.y, player.width, player.height);
        }

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            drawGrid();
            drawPlayer();
        }

        canvas.addEventListener("mousedown", (e) => {
            const rect = canvas.getBoundingClientRect();
            const mx = e.clientX - rect.left;
            const my = e.clientY - rect.top;
            const gx = Math.floor(mx / TILE_SIZE);
            const gy = Math.floor(my / TILE_SIZE);

            if (gx < 0 || gx >= COLS || gy < 0 || gy >= ROWS) return;
            if (e.button === 0) {
                if (selectedBlock !== 0 && !(player.x < (gx + 1) * TILE_SIZE && player.x + player.width > gx * TILE_SIZE && player.y < (gy + 1) * TILE_SIZE && player.y + player.height > gy * TILE_SIZE)) {
                    world[gy][gx] = selectedBlock;
                }
            } else if (e.button === 2) {
                if (world[gy][gx] !== 0) {
                    world[gy][gx] = 0;
                }
            }
        });

        canvas.addEventListener("contextmenu", (e) => {
            e.preventDefault();
        });

        function gameLoop() {
            update();
            draw();
            requestAnimationFrame(gameLoop);
        }

        selectedBlockText.textContent = `선택된 블록: ${BLOCKS[selectedBlock].name}`;
        gameLoop();
    </script>
</body>
</html>
